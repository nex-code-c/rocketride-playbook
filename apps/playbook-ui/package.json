{
  "name": "local-playbook",
  "version": "0.1.1",
  "private": true,
  "description": "Playbook turns a recording of an expert shift into a reviewable, publishable training playbook.",
  "license": "MIT",
  "appManifest": {
    "id": "prabhjeev_sohi.playbook",
    "publisher": "local",
    "name": "Playbook",
    "description": "Turn your best shift into the standard for every shift.",
    "icon": "./icon.svg",
    "readme": "./README.md",
    "categories": [
      "custom"
    ],
    "mode": "free",
    "authenticated": false,
    "projectId": "83f7fbe7-3e64-4475-8bd4-b39e5ef65660"
  },
  "scripts": {
    "dev": "rsbuild dev",
    "build": "tsc --noEmit && rsbuild build",
