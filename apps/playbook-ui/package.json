    "check:setup": "tsx check.ts",
    "release:staging": "tsx release.ts",
    "submit:review": "tsx submit-review.ts",
    "acceptance:video": "tsx acceptance-video.ts",
    "acceptance:image": "tsx acceptance-image.ts"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "qrcode": "^1.5.4",
    "rocketride": "file:../../.rocketride/client/rocketride.tgz",
    "shell": "file:../../.rocketride/shell/shell.tgz"
  },
  "devDependencies": {
    "@module-federation/rsbuild-plugin": "2.5.1",
    "@rsbuild/core": "~2.0.11",
    "@rsbuild/plugin-react": "~2.0.1",
    "@types/node": "^20.19.41",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/qrcode": "^1.5.5",
    "react-refresh": "^0.14.2",
    "tsx": "^4.20.5",
    "typescript": "^5.3.0"
  }
